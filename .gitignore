# Dependencies
node_modules/

# Build output — regenerated by `npm run build`; never commit (the repo had
# no .gitignore at all, which is how a dist/ tree got staged in this pass).
dist/
dist-ssr/

# Local env — .env.example is the only env file that belongs in git
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
*.local
*.log
.vite/

# Test output
coverage/
playwright-report/
test-results/
